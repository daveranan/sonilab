{
  "name": "sonilabs-sound-library-processor",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:crossfade-export": "vitest run src/features/audio-preview/commands.test.ts && cd src-tauri && cargo test crossfade",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:windows": "npm run typecheck && node scripts/bump-build-version.mjs && tauri build --bundles nsis,msi && node scripts/open-build-folder.mjs",
    "smoke:windows": "npm run smoke:release && npm run lint && npm run test && npm run build && npm run build:windows",
    "smoke:release": "node scripts/release-smoke.mjs",
    "release:check-signing": "node scripts/check-signing-readiness.mjs",
    "validate:ffmpeg": "node scripts/validate-ffmpeg.mjs",
    "validate:audiowaveform": "node scripts/validate-audiowaveform.mjs",
    "package:ffmpeg": "node scripts/package-ffmpeg-sidecar.mjs",
    "package:audiowaveform": "node scripts/package-audiowaveform-sidecar.mjs",
    "fixtures:audio": "node scripts/generate-audio-fixtures.mjs",
    "benchmark:phase0": "node scripts/benchmarks/performance-harness.mjs",
    "benchmark:phase2:indexing": "node scripts/benchmarks/phase2-local-indexing.mjs",
    "benchmark:phase3:scrolling": "node scripts/benchmarks/phase3-50k-scrolling.mjs",
    "benchmark:phase5:preview": "node scripts/benchmarks/phase5-cached-preview-switching.mjs",
    "benchmark:quick-browse": "node scripts/benchmarks/quick-browse-selection-export.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6"
  }
}
